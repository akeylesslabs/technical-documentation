.DS_Store
Thumbs.db

# Local editor files (do not ignore entire .vscode so shared tasks/settings can be tracked)
.vscode/settings.json
.vscode/launch.json
.vscode/*.local.json
.github/copilot-instructions.local.md
.cursor/

# Package manager artifacts
node_modules/

# IDE metadata
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python cache
.github/scripts/__pycache__/

# Temporary files
*.tmp